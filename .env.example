# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Buffer integration — server only, never expose as NEXT_PUBLIC_*
BUFFER_API_KEY=

# GitHub Source Reader — server only
# Fine-grained PAT with Contents: Read-only and only selected repositories.
GITHUB_SOURCE_TOKEN=
# Comma-separated owner/repository allowlist.
GITHUB_SOURCE_REPOSITORIES=
# Must also exist in GITHUB_SOURCE_REPOSITORIES when used.
GITHUB_KNOWLEDGE_BASE_REPOSITORY=

# Suggestion Engine / OpenAI — server only
# Never expose OPENAI_API_KEY as NEXT_PUBLIC_*.
OPENAI_API_KEY=
# Model is configuration, not an architectural constant.
OPENAI_SUGGESTION_MODEL=
